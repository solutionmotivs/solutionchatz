# Partner sandbox credentials. COPY this file to .env.partners.local (git-ignored) and fill in what you have.
# Never commit real keys. Never paste them into chat or a ticket. On Render, set them as environment variables instead (dashboard > Environment).
# Test (sandbox) keys only until counsel has cleared a country and you have a signed agreement. See docs/PARTNER_SETUP.md.

# ---- FX / payout wallets (self-serve sandboxes) ----
AIRWALLEX_ENV=sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
WISE_ENV=sandbox
WISE_CLIENT_ID=
WISE_CLIENT_SECRET=
WISE_PROFILE_ID=
WISE_WEBHOOK_PUBLIC_KEY=
CURRENCYCLOUD_ENV=demo
CURRENCYCLOUD_LOGIN_ID=
CURRENCYCLOUD_API_KEY=

# ---- Stablecoin on/off-ramp ----
