# ============================================================
# VAULTE — ENVIRONMENT VARIABLES (copy to .env.local)
# Never commit real values.
# ============================================================

# ── Core (required) ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/vaulte"
# At least 32 chars. Production refuses to start signing/verifying sessions without it.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Security secrets (required in production) ───────────────
# OTP_PEPPER: >= 32 chars, keys the hash of emailed one-time codes.
OTP_PEPPER=""
# ENCRYPTION_KEY: >= 32 chars, AES-256-GCM key for TOTP secrets and KYC documents. Losing it makes them unreadable.
ENCRYPTION_KEY=""
# Tests/dev only: returns one-time codes in API responses. Ignored (never exposed) when NODE_ENV=production.
AUTH_EXPOSE_DEV_OTP="false"

# ── Staff and cron secrets (required for the matching endpoints) ──
# Staff tools (/api/admin/*) use staff accounts with mandatory two-factor: create one with scripts/create-staff.mjs.
# CRON_SECRET: header x-cron-secret. Call POST /api/internal/webhooks/run every minute to deliver/retry customer webhooks.
CRON_SECRET=""

# ── Partners (all optional until you sign agreements; sandbox uses mock partners) ──
# Secret used to verify signed webhooks from the mock partner (sandbox). Required in production if mock partners are enabled.
MOCK_PARTNER_WEBHOOK_SECRET=""
# Quote validity in seconds (firm price window). Default 300.
QUOTE_TTL_SEC="300"
# Chain-analytics provider for wallet screening (Chainalysis / TRM / Elliptic). Hook lives in lib/compliance/wallet.ts.
WALLET_SCREEN_API_KEY=""
# Sanctions screening (name screening). Without it only country-level checks run, which is NOT enough for live money.
COMPLYADVANTAGE_API_KEY=""

# ── FX mid-market rates ──────────────────────────────────────
OPENEXCHANGERATES_APP_ID=""

# ── Email (invoice emails, notifications) ────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Vaulte <noreply@yourdomain.com>"

# ── Legacy single-partner rails (old /api/payments flow) ─────
CURRENCYCLOUD_LOGIN_ID=""
CURRENCYCLOUD_API_KEY=""
CURRENCYCLOUD_ENV="sandbox"
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="test"

# --- KYC / KYB (M2) ---
# mock (dev default, never used in production) | sandbox_co_in | none
KYC_PROVIDER=mock
# SANDBOX_CO_IN_API_KEY=key_test_...
# SANDBOX_CO_IN_API_SECRET=secret_test_...
# SANDBOX_CO_IN_ENV=live            # omit for the test environment
# Evidence documents: encrypted before storage. Production needs an S3-compatible bucket (India region for Indian payment data).
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=                      # for non-AWS stores
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# LOCAL_STORAGE_DIR=./.data/uploads # development only
# FATF increased-monitoring country list (refresh after each FATF plenary), comma-separated ISO codes
# FATF_INCREASED_MONITORING=
# Production: staff may override verification status directly only if this is "true" (leave unset)
# ALLOW_MANUAL_VERIFY_OVERRIDE=

# --- Sanctions (M3) ---
# Review / auto-block thresholds (0-100)
# SANCTIONS_REVIEW_SCORE=88
# SANCTIONS_BLOCK_SCORE=96
# Optional second wallet source
# CHAINALYSIS_API_KEY=

# --- FX providers and Airwallex (M4) ---
# airwallex,mock (mock = sandbox desks, never in production)
# FX_PROVIDERS=airwallex
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
# AIRWALLEX_ENV=live                # omit for the sandbox
# AIRWALLEX_ON_BEHALF_OF=           # connected account id (acct_...); needed so customer funds stay in the customer's own account
# AIRWALLEX_WEBHOOK_SECRET=         # from the webhook endpoint you register: https://YOUR_HOST/api/webhooks/partner/airwallex
# Fees from YOUR Airwallex contract (placeholders if unset: SWIFT 15, local 0)
# AIRWALLEX_SWIFT_FEE_USD=
# AIRWALLEX_LOCAL_FEE_USD=
# AIRWALLEX_CONVERSION_PATH=/api/v1/fx/conversions/create

# Currencycloud (payout + FX partner). Demo by default; CURRENCYCLOUD_ENV=live for live keys.
# CURRENCYCLOUD_LOGIN_ID=
# CURRENCYCLOUD_API_KEY=
# CURRENCYCLOUD_ENV=live
# CURRENCYCLOUD_ON_BEHALF_OF=       # contact id of the customer's own sub-account (custody caution)
# CURRENCYCLOUD_WEBHOOK_SECRET=     # put in the callback URL: https://YOUR_HOST/api/webhooks/partner/currencycloud?s=SECRET
# CURRENCYCLOUD_SWIFT_FEE_USD=
# CURRENCYCLOUD_LOCAL_FEE_USD=

# Wise Platform (payout + FX partner). Sandbox by default; WISE_ENV=live for live.
# WISE_CLIENT_ID=
# WISE_CLIENT_SECRET=
# WISE_ENV=live
# WISE_PROFILE_ID=                  # optional; defaults to the account's business profile
# WISE_WEBHOOK_PUBLIC_KEY=          # PEM from Wise docs for your environment (\n for newlines)
# FX_PROVIDERS=airwallex,currencycloud,wise,mock
# Live FX reference rates (without this key production refuses to quote: there is no hard-coded fallback in production)
# OPENEXCHANGERATES_APP_ID=

# --- Accounting (M5) ---
# NET (agent: only markup is revenue, default) or GROSS (principal: all fees revenue, partner cost expense). Ask your auditor.
# ACCOUNTING_BASIS=NET
# Production: allow the app to create the ledger triggers itself (otherwise run scripts/db-guards.mjs once)
# LEDGER_GUARDS_AUTOINSTALL=

# --- ERP connectors (M7): register a developer app with each vendor; redirect URI = https://YOUR_HOST/api/integrations/<provider>/callback ---
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENV=live              # omit for the sandbox
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_DC=in                       # com | in | eu | com.au | jp  (data centre of the Zoho account)
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# Cron (every 15 min): POST /api/internal/erp/sync with x-cron-secret

# --- Launch (M8) ---
# Live partner catalogue: JSON array of legs from signed partner agreements (see docs/partners.example.json). Empty = no live routes.
# PARTNER_CATALOG_JSON=
# PARTNER_CATALOG_FILE=/etc/vaulte/partners.json
# Policy pages (shown until LEGAL_REVIEWED=true after real legal review)
# COMPANY_LEGAL_NAME=
# COMPANY_ADDRESS=
# COMPANY_REGISTRATION=
# SUPPORT_EMAIL=
# PRIVACY_EMAIL=
# GRIEVANCE_OFFICER_NAME=
# GRIEVANCE_OFFICER_EMAIL=
# GRIEVANCE_OFFICER_PHONE=
# DATA_REGION=
# GOVERNING_LAW=
# LEGAL_REVIEWED=
# LOG_LEVEL=info

# Official registries (M10). VIES (EU VAT) and GLEIF (LEI) need no key.
# COMPANIES_HOUSE_API_KEY=          # free key: developer.company-information.service.gov.uk
# ABN_LOOKUP_GUID=                  # free GUID: abr.business.gov.au/Tools/WebServices
