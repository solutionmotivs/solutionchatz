# ============================================================
# VAULTE — ENVIRONMENT VARIABLES (copy to .env.local)
# Never commit real values.
# ============================================================

# ── Core (required) ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/vaulte"
# At least 32 chars. Production refuses to start signing/verifying sessions without it.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Staff and cron secrets (required for the matching endpoints) ──
# ADMIN_API_TOKEN: min 24 chars. Header x-admin-token. Used by /api/admin/* (KYB/entity verification, transfer review).
ADMIN_API_TOKEN=""
# CRON_SECRET: header x-cron-secret. Call POST /api/internal/webhooks/run every minute to deliver/retry customer webhooks.
CRON_SECRET=""

# ── Partners (all optional until you sign agreements; sandbox uses mock partners) ──
# Secret used to verify signed webhooks from the mock partner (sandbox). Required in production if mock partners are enabled.
MOCK_PARTNER_WEBHOOK_SECRET=""
# Quote validity in seconds (firm price window). Default 300.
QUOTE_TTL_SEC="300"
# Chain-analytics provider for wallet screening (Chainalysis / TRM / Elliptic). Hook lives in lib/compliance/wallet.ts.
WALLET_SCREEN_API_KEY=""
# Sanctions screening (name screening). Without it only country-level checks run, which is NOT enough for live money.
COMPLYADVANTAGE_API_KEY=""

# ── FX mid-market rates ──────────────────────────────────────
OPENEXCHANGERATES_APP_ID=""

# ── Email (invoice emails, notifications) ────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Vaulte <noreply@yourdomain.com>"

# ── Legacy single-partner rails (old /api/payments flow) ─────
CURRENCYCLOUD_LOGIN_ID=""
CURRENCYCLOUD_API_KEY=""
CURRENCYCLOUD_ENV="sandbox"
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="test"
